+package com.example.demoplugin;
+
+import com.google.gerrit.extensions.annotations.PluginName;
+import com.google.gerrit.extensions.api.access.PluginPermission;
+import com.google.gerrit.extensions.restapi.AuthException;
+import com.google.gerrit.server.permissions.PermissionBackend;
+import com.google.gerrit.server.permissions.PermissionBackendException;
+import com.google.gerrit.server.project.ProjectState;
+import com.google.gerrit.sshd.CommandMetaData;
+import com.google.gerrit.sshd.SshCommand;
+import com.google.inject.Inject;
+import org.kohsuke.args4j.Argument;
+import org.kohsuke.args4j.Option;
+
+/**
+ * {@code ssh -p 29418 <host> demo-plugin maintenance <project> [--on|--off]}.
+ *
+ * <p>Without an option it prints the state, which anyone may read; {@code --on} and {@code --off}
+ * need the global capability {@code demo-plugin-maintain}, like the REST views.
+ */
+@CommandMetaData(name = "maintenance", description = "Show or switch maintenance for a project")
+final class MaintenanceCommand extends SshCommand {
+  @Argument(index = 0, required = true, metaVar = "PROJECT", usage = "name of the project")
+  ProjectState projectState;
+
+  @Option(name = "--on", usage = "switch maintenance on")
+  boolean on;
+
+  @Option(name = "--off", usage = "switch maintenance off")
+  boolean off;
+
+  private final String pluginName;
+  private final MaintenanceState state;
+  private final PermissionBackend permissionBackend;
+
+  @Inject
+  MaintenanceCommand(
+      @PluginName String pluginName, MaintenanceState state, PermissionBackend permissionBackend) {
+    this.pluginName = pluginName;
+    this.state = state;
+    this.permissionBackend = permissionBackend;
+  }
+
+  @Override
+  protected void run() throws UnloggedFailure, PermissionBackendException {
+    stdout.println(execute());
+  }
+
+  /** Applies the options and returns the line to print. */
+  String execute() throws UnloggedFailure, PermissionBackendException {
+    if (on && off) {
+      throw die("--on and --off are mutually exclusive");
+    }
+    if (on || off) {
+      try {
+        permissionBackend
+            .currentUser()
+            .check(new PluginPermission(pluginName, MaintainCapability.ID));
+      } catch (AuthException e) {
+        throw die(e.getMessage());
+      }
+      state.set(projectState.getNameKey(), on);
+    }
+    return String.format(
+        "maintenance %s %s",
+        state.isOn(projectState.getNameKey()) ? "on" : "off", projectState.getName());
+  }
+}
diff --git a/src/main/java/com/example/demoplugin/SshModule.java b/src/main/java/com/example/demoplugin/SshModule.java
index d577d3a..b44b0ff 100644
