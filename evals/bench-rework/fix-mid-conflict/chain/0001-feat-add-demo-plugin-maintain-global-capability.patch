+package com.example.demoplugin;
+
+import static com.google.common.truth.Truth.assertThat;
+
+import org.junit.Test;
+
+public class MaintainCapabilityTest {
+  @Test
+  public void idCarriesNoPluginPrefix() {
+    assertThat(MaintainCapability.ID).isEqualTo("maintain");
+  }
+
+  @Test
+  public void descriptionIsShownInTheAccessScreen() {
+    assertThat(new MaintainCapability().getDescription()).isEqualTo("Maintain demo-plugin");
+  }
