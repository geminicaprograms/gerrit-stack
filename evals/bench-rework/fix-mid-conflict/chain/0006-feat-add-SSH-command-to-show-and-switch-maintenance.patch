+package com.example.demoplugin;
+
+import static com.google.common.truth.Truth.assertThat;
+import static org.junit.Assert.assertThrows;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.Mockito.doThrow;
+import static org.mockito.Mockito.when;
+
+import com.google.gerrit.entities.Project;
+import com.google.gerrit.extensions.api.access.PluginPermission;
+import com.google.gerrit.extensions.restapi.AuthException;
+import com.google.gerrit.server.permissions.PermissionBackend;
+import com.google.gerrit.server.project.ProjectState;
+import com.google.gerrit.sshd.BaseCommand.UnloggedFailure;
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.mockito.Mock;
+import org.mockito.junit.MockitoJUnitRunner;
+
+@RunWith(MockitoJUnitRunner.Silent.class)
+public class MaintenanceCommandTest {
+  private static final String PLUGIN = "demo-plugin";
+  private static final Project.NameKey PROJECT = Project.nameKey("team/some-project");
+
+  @Mock private PermissionBackend permissionBackend;
+  @Mock private PermissionBackend.WithUser withUser;
+  @Mock private ProjectState projectState;
+
+  private final MaintenanceState state = new MaintenanceState();
+  private MaintenanceCommand command;
+
+  @Before
+  public void setUp() {
+    when(permissionBackend.currentUser()).thenReturn(withUser);
+    when(projectState.getName()).thenReturn(PROJECT.get());
+    when(projectState.getNameKey()).thenReturn(PROJECT);
+    command = new MaintenanceCommand(PLUGIN, state, permissionBackend);
+    command.projectState = projectState;
+  }
+
+  @Test
+  public void printsTheStateWithoutOptions() throws Exception {
+    assertThat(command.execute()).isEqualTo("maintenance off team/some-project");
+  }
+
+  @Test
+  public void onAndOffSwitchMaintenance() throws Exception {
+    command.on = true;
+    assertThat(command.execute()).isEqualTo("maintenance on team/some-project");
+    assertThat(state.isOn(PROJECT)).isTrue();
+
+    command.on = false;
+    command.off = true;
+    assertThat(command.execute()).isEqualTo("maintenance off team/some-project");
+    assertThat(state.isOn(PROJECT)).isFalse();
+  }
+
+  @Test
+  public void switchingNeedsTheMaintainCapability() throws Exception {
+    doThrow(new AuthException("demo-plugin-maintain not permitted"))
+        .when(withUser)
+        .check(any(PluginPermission.class));
+    command.on = true;
+
+    UnloggedFailure thrown = assertThrows(UnloggedFailure.class, () -> command.execute());
+
+    assertThat(thrown).hasMessageThat().contains("not permitted");
+    assertThat(state.isOn(PROJECT)).isFalse();
+  }
+
+  @Test
+  public void onAndOffTogetherAreRejected() {
+    command.on = true;
+    command.off = true;
+
+    assertThrows(UnloggedFailure.class, () -> command.execute());
+  }
+}
