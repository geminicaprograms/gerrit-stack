+package com.example.demoplugin;
+
+import com.google.gerrit.entities.Project;
+import com.google.inject.Singleton;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * Which projects are in maintenance right now.
+ *
+ * <p>The state lives in memory only: it is meant for short maintenance windows and is gone after a
+ * plugin reload or a Gerrit restart, which both end the window anyway.
+ */
+@Singleton
+public class MaintenanceState {
+  private final Set<Project.NameKey> projects = ConcurrentHashMap.newKeySet();
+
+  /** Whether {@code project} is in maintenance. */
+  public boolean isOn(Project.NameKey project) {
+    return projects.contains(project);
+  }
+
+  /**
+   * Switches maintenance for {@code project} on or off.
+   *
+   * @return {@code true} when the state changed, {@code false} when it already had that value
+   */
+  public boolean set(Project.NameKey project, boolean on) {
+    return on ? projects.add(project) : projects.remove(project);
+  }
+}
diff --git a/src/main/java/com/example/demoplugin/Module.java b/src/main/java/com/example/demoplugin/Module.java
index 988eaa2..346c887 100644
--- a/src/main/java/com/example/demoplugin/Module.java
+++ b/src/main/java/com/example/demoplugin/Module.java
@@ -32,6 +32,7 @@ public class Module extends AbstractModule {
   @Override
   protected void configure() {
     bind(DemoPluginConfig.class);
+    bind(MaintenanceState.class);
     bind(CapabilityDefinition.class)
         .annotatedWith(Exports.named(MaintainCapability.ID))
         .to(MaintainCapability.class);
