+package com.example.demoplugin;
+
+import com.google.gerrit.extensions.config.CapabilityDefinition;
+
+/**
+ * Global capability {@code demo-plugin-maintain}: its holders may switch maintenance on and off.
+ *
+ * <p>Gerrit prefixes the ID of a plugin-owned capability with the plugin name, so {@link #ID} is
+ * only the part after {@code demo-plugin-}.
+ */
+public class MaintainCapability extends CapabilityDefinition {
+  /** ID without the plugin prefix; use it in {@code @RequiresCapability} and permission checks. */
+  public static final String ID = "maintain";
+
+  @Override
+  public String getDescription() {
+    return "Maintain demo-plugin";
+  }
+}
diff --git a/src/main/java/com/example/demoplugin/Module.java b/src/main/java/com/example/demoplugin/Module.java
index 84f7e99..988eaa2 100644
--- a/src/main/java/com/example/demoplugin/Module.java
+++ b/src/main/java/com/example/demoplugin/Module.java
@@ -16,20 +16,25 @@ package com.example.demoplugin;
 
 import static com.google.gerrit.server.project.ProjectResource.PROJECT_KIND;
 
+import com.google.gerrit.extensions.annotations.Exports;
+import com.google.gerrit.extensions.config.CapabilityDefinition;
 import com.google.gerrit.extensions.restapi.RestApiModule;
 import com.google.inject.AbstractModule;
 
 /**
  * Guice module of the demo plugin ({@code Gerrit-Module}).
  *
- * <p>Binds the plugin configuration and the REST endpoints under {@code
- * /projects/{name}/demo-plugin~<view>}. New REST views are registered in the nested {@link
- * RestApiModule}.
+ * <p>Binds the plugin configuration, the global capability {@code demo-plugin-maintain} and the
+ * REST endpoints under {@code /projects/{name}/demo-plugin~<view>}. New REST views are registered
+ * in the nested {@link RestApiModule}.
  */
 public class Module extends AbstractModule {
   @Override
   protected void configure() {
     bind(DemoPluginConfig.class);
+    bind(CapabilityDefinition.class)
+        .annotatedWith(Exports.named(MaintainCapability.ID))
+        .to(MaintainCapability.class);
 
     install(
         new RestApiModule() {
diff --git a/src/main/resources/Documentation/about.md b/src/main/resources/Documentation/about.md
index 949f5cc..da7cbba 100644
--- a/src/main/resources/Documentation/about.md
+++ b/src/main/resources/Documentation/about.md
@@ -1,3 +1,10 @@
 Minimal Gerrit plugin used by the gerrit-stack demo. It exposes one REST view,
 `GET /projects/{name}/demo-plugin~ping`, and one SSH command,
 `demo-plugin ping <project>`, both answering with the configured ping message.
+
+Access
+------
+
+The plugin defines the global capability `demo-plugin-maintain` ("Maintain
+demo-plugin"). Grant it under *All-Projects → Access → Global Capabilities* to
+the groups that may take the plugin into maintenance.
