 .../com/example/demoplugin/SshModule.java     |  1 +
 src/main/resources/Documentation/about.md     |  2 +
 .../demoplugin/MaintenanceCommandTest.java    | 93 +++++++++++++++++++
 4 files changed, 178 insertions(+)
 create mode 100644 src/main/java/com/example/demoplugin/MaintenanceCommand.java
 create mode 100644 src/test/java/com/example/demoplugin/MaintenanceCommandTest.java

