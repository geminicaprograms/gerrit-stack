@@ -42,6 +42,9 @@ public class Module extends AbstractModule {
           @Override
           protected void configure() {
             get(PROJECT_KIND, "ping").to(PingAction.class);
+            get(PROJECT_KIND, "maintenance").to(MaintenanceViews.Get.class);
+            put(PROJECT_KIND, "maintenance").to(MaintenanceViews.Put.class);
+            delete(PROJECT_KIND, "maintenance").to(MaintenanceViews.Delete.class);
           }
         });
   }
diff --git a/src/main/resources/Documentation/about.md b/src/main/resources/Documentation/about.md
index da7cbba..df9d892 100644
--- a/src/main/resources/Documentation/about.md
+++ b/src/main/resources/Documentation/about.md
@@ -2,6 +2,14 @@ Minimal Gerrit plugin used by the gerrit-stack demo. It exposes one REST view,
 `GET /projects/{name}/demo-plugin~ping`, and one SSH command,
 `demo-plugin ping <project>`, both answering with the configured ping message.
 
+Maintenance
+-----------
+
+`GET /projects/{name}/demo-plugin~maintenance` answers
+`{"project":"<name>","maintenance":false}`. `PUT` switches maintenance on for
+that project and `DELETE` switches it off; both need the capability below.
+The state is kept in memory and ends with a Gerrit restart.
+
