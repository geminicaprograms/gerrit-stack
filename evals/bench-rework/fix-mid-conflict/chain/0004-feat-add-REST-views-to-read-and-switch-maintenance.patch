+package com.example.demoplugin;
+
+import com.google.gerrit.extensions.annotations.RequiresCapability;
+import com.google.gerrit.extensions.restapi.Response;
+import com.google.gerrit.extensions.restapi.RestModifyView;
+import com.google.gerrit.extensions.restapi.RestReadView;
+import com.google.gerrit.server.project.ProjectResource;
+import com.google.inject.Inject;
+import com.google.inject.Singleton;
+
+/**
+ * REST views behind {@code /projects/{name}/demo-plugin~maintenance}.
+ *
+ * <p>{@code GET} is open to everyone who can see the project; {@code PUT} (on) and {@code DELETE}
+ * (off) need the global capability {@code demo-plugin-maintain}.
+ */
+public final class MaintenanceViews {
+  /** JSON body of the maintenance responses. */
+  public static class MaintenanceInfo {
+    public String project;
+    public boolean maintenance;
+
+    MaintenanceInfo(String project, boolean maintenance) {
+      this.project = project;
+      this.maintenance = maintenance;
+    }
+  }
+
+  /** Empty request body of {@code PUT} and {@code DELETE}. */
+  public static class Input {}
+
+  /** {@code GET /projects/{name}/demo-plugin~maintenance}. */
+  @Singleton
+  public static class Get implements RestReadView<ProjectResource> {
+    private final MaintenanceState state;
+
+    @Inject
+    Get(MaintenanceState state) {
+      this.state = state;
+    }
+
+    @Override
+    public Response<MaintenanceInfo> apply(ProjectResource rsrc) {
+      return Response.ok(new MaintenanceInfo(rsrc.getName(), state.isOn(rsrc.getNameKey())));
+    }
+  }
+
+  /** {@code PUT /projects/{name}/demo-plugin~maintenance} switches maintenance on. */
+  @RequiresCapability(MaintainCapability.ID)
+  @Singleton
+  public static class Put implements RestModifyView<ProjectResource, Input> {
+    private final MaintenanceState state;
+
+    @Inject
+    Put(MaintenanceState state) {
+      this.state = state;
+    }
+
+    @Override
+    public Response<MaintenanceInfo> apply(ProjectResource rsrc, Input input) {
+      state.set(rsrc.getNameKey(), true);
+      return Response.ok(new MaintenanceInfo(rsrc.getName(), true));
+    }
+  }
+
+  /** {@code DELETE /projects/{name}/demo-plugin~maintenance} switches maintenance off. */
+  @RequiresCapability(MaintainCapability.ID)
+  @Singleton
+  public static class Delete implements RestModifyView<ProjectResource, Input> {
+    private final MaintenanceState state;
+
+    @Inject
+    Delete(MaintenanceState state) {
+      this.state = state;
+    }
+
+    @Override
+    public Response<MaintenanceInfo> apply(ProjectResource rsrc, Input input) {
+      state.set(rsrc.getNameKey(), false);
+      return Response.ok(new MaintenanceInfo(rsrc.getName(), false));
+    }
+  }
+
+  private MaintenanceViews() {}
+}
