+package com.example.demoplugin;
+
+import static com.google.common.truth.Truth.assertThat;
+
+import com.google.gerrit.entities.Project;
+import org.junit.Test;
+
+public class MaintenanceStateTest {
+  private static final Project.NameKey PROJECT = Project.nameKey("team/some-project");
+  private static final Project.NameKey OTHER = Project.nameKey("team/other-project");
+
+  private final MaintenanceState state = new MaintenanceState();
+
+  @Test
+  public void projectsAreNotInMaintenanceByDefault() {
+    assertThat(state.isOn(PROJECT)).isFalse();
+  }
+
+  @Test
+  public void switchingOnAffectsOnlyThatProject() {
+    assertThat(state.set(PROJECT, true)).isTrue();
+
+    assertThat(state.isOn(PROJECT)).isTrue();
+    assertThat(state.isOn(OTHER)).isFalse();
+  }
+
+  @Test
+  public void switchingOffEndsMaintenance() {
+    state.set(PROJECT, true);
+
+    assertThat(state.set(PROJECT, false)).isTrue();
+
+    assertThat(state.isOn(PROJECT)).isFalse();
+  }
+
+  @Test
+  public void settingTheSameValueTwiceReportsNoChange() {
+    state.set(PROJECT, true);
+
+    assertThat(state.set(PROJECT, true)).isFalse();
+    assertThat(state.set(OTHER, false)).isFalse();
+  }
+}
