# gerrit-stack demo site config (tracked). The image entrypoint appends
# gerrit.serverId, container.javaHome and extra container.javaOptions on the
# first start; demo/reset.sh restores this file from git.
[gerrit]
	basePath = git
	canonicalWebUrl = http://localhost:8080/
[auth]
	type = DEVELOPMENT_BECOME_ANY_ACCOUNT
	gitBasicAuthPolicy = HTTP
[sshd]
	listenAddress = *:29418
[httpd]
	listenUrl = http://*:8080/
[index]
	type = LUCENE
[cache]
	directory = cache
[sendemail]
	enable = false
	smtpServer = localhost
[plugins]
	allowRemoteAdmin = true
[container]
	user = gerrit
	javaOptions = -Djava.security.egd=file:/dev/./urandom
[receive]
	enableSignedPush = false
[change]
	submitWholeTopic = false
