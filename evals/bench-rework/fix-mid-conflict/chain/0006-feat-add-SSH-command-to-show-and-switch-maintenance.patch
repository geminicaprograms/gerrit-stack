+++ b/src/main/java/com/example/demoplugin/SshModule.java
@@ -31,5 +31,6 @@ public class SshModule extends PluginCommandModule {
   @Override
   protected void configureCommands() {
     command(PingCommand.class);
+    command(MaintenanceCommand.class);
   }
 }
