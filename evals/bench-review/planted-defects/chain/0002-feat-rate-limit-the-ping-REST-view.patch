+++ b/src/main/java/com/example/demoplugin/PingAction.java
@@ -25,7 +25,8 @@ import com.google.inject.Singleton;
  * {@code GET /projects/{name}/demo-plugin~ping}.
  *
  * <p>Answers {@code {"plugin":"demo-plugin","project":"<name>","message":"pong"}}; the message
- * comes from {@link DemoPluginConfig#pingMessage()}.
+ * comes from {@link DemoPluginConfig#pingMessage()}. Once the project is over {@link
+ * DemoPluginConfig#pingRateLimit()} for the current minute the status is 429 Too Many Requests.
  */
 @Singleton
 public class PingAction implements RestReadView<ProjectResource> {
@@ -44,15 +45,21 @@ public class PingAction implements RestReadView<ProjectResource> {
 
   private final String pluginName;
   private final DemoPluginConfig config;
+  private final PingRateLimiter limiter;
 
   @Inject
-  PingAction(@PluginName String pluginName, DemoPluginConfig config) {
+  PingAction(@PluginName String pluginName, DemoPluginConfig config, PingRateLimiter limiter) {
     this.pluginName = pluginName;
     this.config = config;
+    this.limiter = limiter;
   }
 
   @Override
   public Response<PingInfo> apply(ProjectResource rsrc) {
+    if (!limiter.tryAcquire(rsrc.getName())) {
+      return Response.withStatusCode(
+          429, new PingInfo(pluginName, rsrc.getName(), "ping rate limit exceeded"));
+    }
     return Response.ok(new PingInfo(pluginName, rsrc.getName(), config.pingMessage()));
   }
 }
