 .../example/demoplugin/PingRateLimiter.java   | 74 +++++++++++++++++++
 src/main/resources/Documentation/config.md    |  3 +-
 .../example/demoplugin/PingActionTest.java    | 15 +++-
 .../demoplugin/PingRateLimiterTest.java       | 66 +++++++++++++++++
 5 files changed, 165 insertions(+), 4 deletions(-)
