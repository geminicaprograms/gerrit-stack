+package com.example.demoplugin;
+
+import com.google.inject.Inject;
+import com.google.inject.Singleton;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.function.LongSupplier;
+
+/**
+ * Bounds the pings answered per project to {@link DemoPluginConfig#pingRateLimit()} per minute.
+ *
+ * <p>Pings are counted in fixed one-minute windows; a new minute starts a new count.
+ */
+@Singleton
+class PingRateLimiter {
+  private static final Map<String, Window> WINDOWS = new ConcurrentHashMap<>();
+
+  private final DemoPluginConfig config;
+  private final LongSupplier clock;
+
+  @Inject
+  PingRateLimiter(DemoPluginConfig config) {
+    this(config, System::currentTimeMillis);
+  }
+
+  PingRateLimiter(DemoPluginConfig config, LongSupplier clock) {
+    this.config = config;
+    this.clock = clock;
+  }
+
+  /**
+   * Counts one ping for {@code project}.
+   *
+   * @return {@code false} when the project has used up its pings for the current minute
+   */
+  boolean tryAcquire(String project) {
+    int limit = config.pingRateLimit();
+    if (limit == 0) {
+      return true;
+    }
+    long minute = TimeUnit.MILLISECONDS.toMinutes(clock.getAsLong());
+    Window window =
+        WINDOWS.compute(
+            project,
+            (name, current) ->
+                current == null || current.minute != minute ? new Window(minute) : current);
+    return window.count.incrementAndGet() < limit;
+  }
+
+  private static final class Window {
+    final long minute;
+    final AtomicInteger count = new AtomicInteger();
+
+    Window(long minute) {
+      this.minute = minute;
+    }
+  }
+}
