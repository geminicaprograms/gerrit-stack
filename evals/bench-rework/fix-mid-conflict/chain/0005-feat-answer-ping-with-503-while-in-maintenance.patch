--- a/src/main/java/com/example/demoplugin/PingAction.java
+++ b/src/main/java/com/example/demoplugin/PingAction.java
@@ -25,7 +25,8 @@ import com.google.inject.Singleton;
  * {@code GET /projects/{name}/demo-plugin~ping}.
  *
  * <p>Answers {@code {"plugin":"demo-plugin","project":"<name>","message":"pong"}}; the message
- * comes from {@link DemoPluginConfig#pingMessage()}.
+ * comes from {@link DemoPluginConfig#pingMessage()}. While the project is in maintenance it throws
+ * {@link MaintenanceException} (503) with {@link DemoPluginConfig#maintenanceMessage(String)}.
  */
 @Singleton
 public class PingAction implements RestReadView<ProjectResource> {
@@ -44,15 +45,20 @@ public class PingAction implements RestReadView<ProjectResource> {
 
   private final String pluginName;
   private final DemoPluginConfig config;
+  private final MaintenanceState maintenance;
 
   @Inject
-  PingAction(@PluginName String pluginName, DemoPluginConfig config) {
+  PingAction(@PluginName String pluginName, DemoPluginConfig config, MaintenanceState maintenance) {
     this.pluginName = pluginName;
     this.config = config;
+    this.maintenance = maintenance;
   }
 
   @Override
   public Response<PingInfo> apply(ProjectResource rsrc) {
+    if (maintenance.isOn(rsrc.getNameKey())) {
+      throw new MaintenanceException(config.maintenanceMessage(rsrc.getName()));
+    }
     return Response.ok(new PingInfo(pluginName, rsrc.getName(), config.pingMessage()));
   }
 }
diff --git a/src/main/java/com/example/demoplugin/PingCommand.java b/src/main/java/com/example/demoplugin/PingCommand.java
index b94f94c..284e9bf 100644
--- a/src/main/java/com/example/demoplugin/PingCommand.java
+++ b/src/main/java/com/example/demoplugin/PingCommand.java
@@ -20,21 +20,29 @@ import com.google.gerrit.sshd.SshCommand;
 import com.google.inject.Inject;
 import org.kohsuke.args4j.Argument;
 
-/** {@code ssh -p 29418 <host> demo-plugin ping <project>} prints {@code pong <project>}. */
+/**
+ * {@code ssh -p 29418 <host> demo-plugin ping <project>} prints {@code pong <project>}; while the
+ * project is in maintenance it fails with the maintenance message instead.
+ */
 @CommandMetaData(name = "ping", description = "Print the ping message for a project")
 final class PingCommand extends SshCommand {
   @Argument(index = 0, required = true, metaVar = "PROJECT", usage = "name of the project")
   private ProjectState projectState;
 
   private final DemoPluginConfig config;
+  private final MaintenanceState maintenance;
 
   @Inject
-  PingCommand(DemoPluginConfig config) {
+  PingCommand(DemoPluginConfig config, MaintenanceState maintenance) {
     this.config = config;
+    this.maintenance = maintenance;
   }
 
   @Override
-  protected void run() {
+  protected void run() throws UnloggedFailure {
+    if (maintenance.isOn(projectState.getNameKey())) {
+      throw die(config.maintenanceMessage(projectState.getName()));
+    }
     stdout.println(config.pingMessage() + " " + projectState.getName());
   }
 }
