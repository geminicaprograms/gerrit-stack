+package com.example.demoplugin;
+
+import static com.google.common.truth.Truth.assertThat;
+import static org.mockito.Mockito.when;
+
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicLong;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.mockito.Mock;
+import org.mockito.junit.MockitoJUnitRunner;
+
+@RunWith(MockitoJUnitRunner.class)
+public class PingRateLimiterTest {
+  @Mock private DemoPluginConfig config;
+
+  private final AtomicLong now = new AtomicLong(TimeUnit.HOURS.toMillis(1));
+
+  @Test
+  public void unlimitedByDefault() {
+    when(config.pingRateLimit()).thenReturn(0);
+    PingRateLimiter limiter = new PingRateLimiter(config, now::get);
+
+    for (int i = 0; i < 100; i++) {
+      assertThat(limiter.tryAcquire("unlimited-project")).isTrue();
+    }
+  }
+
+  @Test
+  public void rejectsPingsOverTheLimit() {
+    when(config.pingRateLimit()).thenReturn(2);
+    PingRateLimiter limiter = new PingRateLimiter(config, now::get);
+
+    assertThat(limiter.tryAcquire("busy-project")).isTrue();
+    limiter.tryAcquire("busy-project");
+
+    assertThat(limiter.tryAcquire("busy-project")).isFalse();
+    assertThat(limiter.tryAcquire("quiet-project")).isTrue();
+  }
+
+  @Test
+  public void aNewMinuteStartsANewCount() {
+    when(config.pingRateLimit()).thenReturn(2);
+    PingRateLimiter limiter = new PingRateLimiter(config, now::get);
+    limiter.tryAcquire("periodic-project");
+    limiter.tryAcquire("periodic-project");
+
+    now.addAndGet(TimeUnit.MINUTES.toMillis(1));
+
+    assertThat(limiter.tryAcquire("periodic-project")).isTrue();
+  }
+}
