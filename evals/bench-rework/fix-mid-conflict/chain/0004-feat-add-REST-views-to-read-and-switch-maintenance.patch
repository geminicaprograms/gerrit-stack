+package com.example.demoplugin;
+
+import static com.google.common.truth.Truth.assertThat;
+import static org.mockito.Mockito.when;
+
+import com.google.gerrit.entities.Project;
+import com.google.gerrit.extensions.annotations.RequiresCapability;
+import com.google.gerrit.extensions.restapi.Response;
+import com.google.gerrit.server.project.ProjectResource;
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.mockito.Mock;
+import org.mockito.junit.MockitoJUnitRunner;
+
+@RunWith(MockitoJUnitRunner.class)
+public class MaintenanceViewsTest {
+  private static final Project.NameKey PROJECT = Project.nameKey("team/some-project");
+
+  @Mock private ProjectResource project;
+
+  private final MaintenanceState state = new MaintenanceState();
+
+  @Before
+  public void setUp() {
+    when(project.getName()).thenReturn(PROJECT.get());
+    when(project.getNameKey()).thenReturn(PROJECT);
+  }
+
+  @Test
+  public void getReportsTheCurrentState() {
+    Response<MaintenanceViews.MaintenanceInfo> response =
+        new MaintenanceViews.Get(state).apply(project);
+
+    assertThat(response.statusCode()).isEqualTo(200);
+    assertThat(response.value().project).isEqualTo(PROJECT.get());
+    assertThat(response.value().maintenance).isFalse();
+  }
+
+  @Test
+  public void putSwitchesMaintenanceOnAndDeleteOff() {
+    MaintenanceViews.Input input = new MaintenanceViews.Input();
+
+    assertThat(new MaintenanceViews.Put(state).apply(project, input).value().maintenance).isTrue();
+    assertThat(state.isOn(PROJECT)).isTrue();
+
+    assertThat(new MaintenanceViews.Delete(state).apply(project, input).value().maintenance)
+        .isFalse();
+    assertThat(state.isOn(PROJECT)).isFalse();
+  }
+
+  @Test
+  public void onlyTheWritingViewsRequireTheCapability() {
+    assertThat(MaintenanceViews.Get.class.getAnnotation(RequiresCapability.class)).isNull();
+    assertThat(MaintenanceViews.Put.class.getAnnotation(RequiresCapability.class).value())
+        .isEqualTo(MaintainCapability.ID);
+    assertThat(MaintenanceViews.Delete.class.getAnnotation(RequiresCapability.class).value())
+        .isEqualTo(MaintainCapability.ID);
+  }
+}
