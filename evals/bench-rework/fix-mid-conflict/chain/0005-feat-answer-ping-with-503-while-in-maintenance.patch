+package com.example.demoplugin;
+
+import com.google.common.collect.ImmutableList;
+import com.google.common.collect.ImmutableSet;
+import com.google.gerrit.server.ExceptionHook;
+import java.util.Optional;
+
+/**
+ * Thrown by a REST view of a project that is in maintenance.
+ *
+ * <p>A view cannot return a 5xx status itself ({@code Response.withStatusCode} rejects it), so
+ * {@link Hook} tells Gerrit to answer this exception with 503 and its message.
+ */
+public class MaintenanceException extends RuntimeException {
+  private static final long serialVersionUID = 1L;
+
+  static final int SC_SERVICE_UNAVAILABLE = 503;
+
+  public MaintenanceException(String message) {
+    super(message);
+  }
+
+  /** Maps {@link MaintenanceException} to {@code 503 Service Unavailable}. */
+  public static class Hook implements ExceptionHook {
+    @Override
+    public Optional<Status> getStatus(Throwable throwable) {
+      return throwable instanceof MaintenanceException
+          ? Optional.of(Status.create(SC_SERVICE_UNAVAILABLE, "Service Unavailable"))
+          : Optional.empty();
+    }
+
+    @Override
+    public ImmutableList<String> getUserMessages(Throwable throwable, ImmutableSet<String> ids) {
+      return throwable instanceof MaintenanceException
+          ? ImmutableList.of(throwable.getMessage())
+          : ImmutableList.of();
+    }
+  }
+}
